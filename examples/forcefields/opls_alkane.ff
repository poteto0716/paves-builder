# OPLS-AA alkane subset (Jorgensen, Maxwell and Tirado-Rives, JACS 1996).
units          real
special_bonds  lj 0.0 0.0 0.5  coul 0.0 0.0 0.5
pair_style     lj/cut/coul/cut 12.0 12.0
pair_modify    mix geometric
dielectric     1.0

atom     CT3   12.011   -0.180   3.500   0.066
atom     CT2   12.011   -0.120   3.500   0.066
