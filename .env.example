# Optional Compose settings. Copy to .env, or export these variables in the shell.
# On Linux, set these to the output of `id -u` and `id -g`.
PAVES_UID=1000
PAVES_GID=1000
JUPYTER_PORT=8888
PAVES_CPU_THREADS=2
# Empty means Jupyter generates a random token. Find the login URL in Compose logs.
PAVES_JUPYTER_TOKEN=
